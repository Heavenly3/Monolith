{
  "name": "mythcore",
  "version": "3.0.0",
  "description": "A medieval fantasy economy and tavern-games bot for Discord.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Heavenly3",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heavenly3/Mythcore.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @mythcore/bot",
    "dev": "npm run dev -w @mythcore/bot",
    "deploy": "npm run deploy -w @mythcore/bot --",
    "api": "npm run start -w @mythcore/api",
    "dev:api": "npm run dev -w @mythcore/api",
    "web": "npm run dev -w @mythcore/web",
    "build:web": "npm run build -w @mythcore/web",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @mythcore/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm test",
    "migrate:legacy": "node scripts/migrate-legacy.ts",
    "seed:shop": "node scripts/seed-shop.ts",
    "emojis": "node scripts/emojis.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
