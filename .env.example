# Copy this file to .env and fill it in. Never put real values in this file:
# it is committed to git, .env is not.

# Discord Developer Portal → your application → Bot → Reset Token
TOKEN=your_discord_bot_token

# Discord Developer Portal → your application → General Information → Application ID
CLIENT_ID=your_application_id

# Optional: server ID for instant command updates while developing.
# Leave empty to deploy commands globally.
GUILD_ID=

# Optional: where the SQLite database lives (default: storage/mythcore.db)
DATABASE_PATH=storage/mythcore.db

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Web dashboard (npm run api) ---
# Developer Portal → your application → OAuth2 → Client Secret.
# Also add <API_URL>/auth/callback under OAuth2 → Redirects.
CLIENT_SECRET=your_client_secret

# Optional: port and public address of the API (default: http://localhost:3000)
API_PORT=3000
API_URL=http://localhost:3000

# Optional: address of the dashboard (default: http://localhost:5173)
WEB_URL=http://localhost:5173
